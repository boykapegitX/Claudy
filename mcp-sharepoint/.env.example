# Copy to .env and fill in. Load with `set -a; source .env; set +a` (bash)
# or use a tool like direnv / python-dotenv. .env is gitignored.

# From Azure portal > App registrations > your app > Overview
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Accenture tenant ID, or "organizations" (any work/school), or "common" (any).
# For single-tenant apps, set to the Accenture Directory (tenant) ID.
GRAPH_TENANT_ID=organizations

# Space-separated Graph delegated scopes. Narrow these if admin consent is denied.
# Files.Read (own files only) and User.Read usually work without admin consent.
GRAPH_SCOPES=User.Read Files.Read.All Sites.Read.All

# Optional: override token cache location
# GRAPH_TOKEN_CACHE=C:\Users\you\.mcp_sharepoint_token_cache.bin
